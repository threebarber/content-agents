# Copy to .env for local runs. In Trigger.dev these are project env vars.
ANTHROPIC_API_KEY=
APIFY_TOKEN=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=content-agents
GITHUB_TOKEN=            # fine-grained PAT: Contents read+write, ONLY on STATE_REPO
BRAIN_GITHUB_TOKEN=      # optional second fine-grained PAT: Contents read-only, ONLY on BRAIN_REPO (falls back to GITHUB_TOKEN)
GITHUB_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=         # xoxb-… from api.slack.com/apps/<app id>/oauth (content-agents app, see slack-app/)
SLACK_CHANNEL=#content-agents   # where idea cards + retro digests go
SLACK_SIGNING_SECRET=    # intake relay (Phase 2)
STATE_REPO=              # e.g. owner/content-agents-state
BRAIN_REPO=              # e.g. owner/notes-repo (optional)
STATE_DIR=./state        # local checkout of STATE_REPO (default for CLI)
